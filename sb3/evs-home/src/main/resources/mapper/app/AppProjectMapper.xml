<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.app.mapper.AppProjectMapper">
    
    <!-- 根据项目ID列表查询项目 -->
    <select id="selectProjectsByIds" resultType="com.ruoyi.web.domain.Projects">
        SELECT id, project_type, name, customer_id, description, address, area, budget,
               start_date, end_date, status, priority, progress
        FROM projects 
        WHERE deleted_at IS NULL
        <if test="ids != null and ids.size() > 0">
            AND id IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">
                #{id}
            </foreach>
        </if>
        ORDER BY created_at DESC
    </select>
    
</mapper>
