<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.ProjectsMapper">
    
    <resultMap type="Projects" id="ProjectsResult">
        <result property="id"    column="id"    />
        <result property="projectType"    column="project_type"    />
        <result property="name"    column="name"    />
        <result property="customerId"    column="customer_id"    />
        <result property="description"    column="description"    />
        <result property="address"    column="address"    />
        <result property="area"    column="area"    />
        <result property="budget"    column="budget"    />
        <result property="actualCost"    column="actual_cost"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="actualEndDate"    column="actual_end_date"    />
        <result property="status"    column="status"    />
        <result property="priority"    column="priority"    />
        <result property="progress"    column="progress"    />
        <result property="budgetsUrl"    column="budgets_url"    />
        <result property="contractsUrl"    column="contracts_url"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="deletedAt"    column="deleted_at"    />
        <result property="createdBy"    column="created_by"    />
        <result property="updatedBy"    column="updated_by"    />
    </resultMap>

    <sql id="selectProjectsVo">
        select id, project_type, name, customer_id, description, address, area, budget, actual_cost, start_date, end_date, actual_end_date, status, priority, progress, budgets_url, contracts_url, created_at, updated_at, deleted_at, created_by, updated_by from projects
    </sql>

    <select id="selectProjectsList" parameterType="Projects" resultMap="ProjectsResult">
        <include refid="selectProjectsVo"/>
        <where>  
            <if test="projectType != null  and projectType != ''"> and project_type = #{projectType}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="priority != null  and priority != ''"> and priority = #{priority}</if>
        </where>
    </select>
    
    <select id="selectProjectsById" parameterType="String" resultMap="ProjectsResult">
        <include refid="selectProjectsVo"/>
        where id = #{id}
    </select>

    <insert id="insertProjects" parameterType="Projects">
        insert into projects
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectType != null and projectType != ''">project_type,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="description != null">description,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="area != null">area,</if>
            <if test="budget != null">budget,</if>
            <if test="actualCost != null">actual_cost,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="actualEndDate != null">actual_end_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="priority != null and priority != ''">priority,</if>
            <if test="progress != null">progress,</if>
            <if test="budgetsUrl != null">budgets_url,</if>
            <if test="contractsUrl != null">contracts_url,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="deletedAt != null">deleted_at,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectType != null and projectType != ''">#{projectType},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="description != null">#{description},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="area != null">#{area},</if>
            <if test="budget != null">#{budget},</if>
            <if test="actualCost != null">#{actualCost},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="actualEndDate != null">#{actualEndDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="priority != null and priority != ''">#{priority},</if>
            <if test="progress != null">#{progress},</if>
            <if test="budgetsUrl != null">#{budgetsUrl},</if>
            <if test="contractsUrl != null">#{contractsUrl},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="deletedAt != null">#{deletedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateProjects" parameterType="Projects">
        update projects
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectType != null and projectType != ''">project_type = #{projectType},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="area != null">area = #{area},</if>
            <if test="budget != null">budget = #{budget},</if>
            <if test="actualCost != null">actual_cost = #{actualCost},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="actualEndDate != null">actual_end_date = #{actualEndDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="priority != null and priority != ''">priority = #{priority},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="budgetsUrl != null">budgets_url = #{budgetsUrl},</if>
            <if test="contractsUrl != null">contracts_url = #{contractsUrl},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProjectsById" parameterType="String">
        delete from projects where id = #{id}
    </delete>

    <delete id="deleteProjectsByIds" parameterType="String">
        delete from projects where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>