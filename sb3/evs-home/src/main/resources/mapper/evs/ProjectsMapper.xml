<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.ProjectsMapper">
    
    <resultMap type="Projects" id="ProjectsResult">
        <result property="id"    column="id"    />
        <result property="projectType"    column="project_type"    />
        <result property="name"    column="name"    />
        <result property="customerId"    column="customer_id"    />
        <result property="description"    column="description"    />
        <result property="address"    column="address"    />
        <result property="area"    column="area"    />
        <result property="budget"    column="budget"    />
        <result property="actualCost"    column="actual_cost"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="actualEndDate"    column="actual_end_date"    />
        <result property="status"    column="status"    />
        <result property="priority"    column="priority"    />
        <result property="progress"    column="progress"    />
        <result property="budgetsUrl"    column="budgets_url"    />
        <result property="contractsUrl"    column="contracts_url"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="deletedAt"    column="deleted_at"    />
        <result property="createdBy"    column="created_by"    />
        <result property="updatedBy"    column="updated_by"    />
    </resultMap>

    <resultMap type="Projects" id="ProjectsWithCustomerResult" extends="ProjectsResult">
        <association property="customer" javaType="Customers">
            <id property="id" column="customer_id"/>
            <result property="name" column="customer_name"/>
            <result property="phone" column="customer_phone"/>
            <result property="email" column="customer_email"/>
            <result property="address" column="customer_address"/>
            <result property="level" column="customer_level"/>
            <result property="source" column="customer_source"/>
            <result property="isActive" column="customer_is_active"/>
        </association>
    </resultMap>

    <sql id="selectProjectsVo">
        select id, project_type, name, customer_id, description, address, area, budget, actual_cost, start_date, end_date, actual_end_date, status, priority, progress, budgets_url, contracts_url, created_at, updated_at, deleted_at, created_by, updated_by from projects
    </sql>

    <select id="selectProjectsList" parameterType="Projects" resultMap="ProjectsResult">
        <include refid="selectProjectsVo"/>
        <where>  
            <if test="projectType != null  and projectType != ''"> and project_type = #{projectType}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="priority != null  and priority != ''"> and priority = #{priority}</if>
        </where>
    </select>
    
    <select id="selectProjectsById" parameterType="String" resultMap="ProjectsResult">
        <include refid="selectProjectsVo"/>
        where id = #{id}
    </select>

    <insert id="insertProjects" parameterType="Projects">
        insert into projects
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectType != null and projectType != ''">project_type,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="description != null">description,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="area != null">area,</if>
            <if test="budget != null">budget,</if>
            <if test="actualCost != null">actual_cost,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="actualEndDate != null">actual_end_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="priority != null and priority != ''">priority,</if>
            <if test="progress != null">progress,</if>
            <if test="budgetsUrl != null">budgets_url,</if>
            <if test="contractsUrl != null">contracts_url,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="deletedAt != null">deleted_at,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectType != null and projectType != ''">#{projectType},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="description != null">#{description},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="area != null">#{area},</if>
            <if test="budget != null">#{budget},</if>
            <if test="actualCost != null">#{actualCost},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="actualEndDate != null">#{actualEndDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="priority != null and priority != ''">#{priority},</if>
            <if test="progress != null">#{progress},</if>
            <if test="budgetsUrl != null">#{budgetsUrl},</if>
            <if test="contractsUrl != null">#{contractsUrl},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="deletedAt != null">#{deletedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateProjects" parameterType="Projects">
        update projects
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectType != null and projectType != ''">project_type = #{projectType},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="area != null">area = #{area},</if>
            <if test="budget != null">budget = #{budget},</if>
            <if test="actualCost != null">actual_cost = #{actualCost},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="actualEndDate != null">actual_end_date = #{actualEndDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="priority != null and priority != ''">priority = #{priority},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="budgetsUrl != null">budgets_url = #{budgetsUrl},</if>
            <if test="contractsUrl != null">contracts_url = #{contractsUrl},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProjectsById" parameterType="String">
        delete from projects where id = #{id}
    </delete>

    <delete id="deleteProjectsByIds" parameterType="String">
        delete from projects where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 关联查询项目信息（包含客户信息） -->
    <sql id="selectProjectsWithCustomerVo">
        SELECT
            p.id, p.project_type, p.name, p.customer_id, p.description, p.address,
            p.area, p.budget, p.actual_cost, p.start_date, p.end_date,
            p.actual_end_date, p.status, p.priority, p.progress,
            p.budgets_url, p.contracts_url, p.created_at, p.updated_at,
            p.deleted_at, p.created_by, p.updated_by,
            c.name as customer_name, c.phone as customer_phone, c.email as customer_email,
            c.address as customer_address, c.level as customer_level,
            c.source as customer_source, c.is_active as customer_is_active
        FROM projects p
        LEFT JOIN customers c ON p.customer_id = c.id
    </sql>

    <select id="selectProjectsWithCustomer" parameterType="Projects" resultMap="ProjectsWithCustomerResult">
        <include refid="selectProjectsWithCustomerVo"/>
        <where>
            <if test="projectType != null and projectType != ''"> and p.project_type = #{projectType}</if>
            <if test="name != null and name != ''"> and p.name like concat('%', #{name}, '%')</if>
            <if test="status != null and status != ''"> and p.status = #{status}</if>
            <if test="priority != null and priority != ''"> and p.priority = #{priority}</if>
            <if test="customerId != null and customerId != ''"> and p.customer_id = #{customerId}</if>
        </where>
        ORDER BY p.created_at DESC
    </select>

    <select id="selectProjectsWithCustomerById" parameterType="String" resultMap="ProjectsWithCustomerResult">
        <include refid="selectProjectsWithCustomerVo"/>
        WHERE p.id = #{id}
    </select>

    <!-- 通过项目成员关联查询项目列表（支持权限过滤） -->
    <sql id="selectProjectsWithMembersVo">
        SELECT
            p.id, p.project_type, p.name, p.customer_id, p.description, p.address,
            p.area, p.budget, p.actual_cost, p.start_date, p.end_date,
            p.actual_end_date, p.status, p.priority, p.progress,
            p.budgets_url, p.contracts_url, p.created_at, p.updated_at,
            p.deleted_at, p.created_by, p.updated_by,
            c.name as customer_name, c.phone as customer_phone, c.email as customer_email,
            c.address as customer_address, c.level as customer_level,
            c.source as customer_source, c.is_active as customer_is_active
        FROM projects p
        LEFT JOIN customers c ON p.customer_id = c.id
        <where>
            <!-- 非管理员用户只能看到自己参与的项目 -->
            <if test="isAdmin != null and isAdmin == false">
                AND p.id IN (
                    SELECT DISTINCT pm.project_id
                    FROM project_members pm
                    WHERE pm.user_id = #{memberUserId} AND pm.is_active = 1
                )
            </if>
        </where>
    </sql>

    <select id="selectProjectsWithMembers" parameterType="Projects" resultMap="ProjectsWithCustomerResult">
        <include refid="selectProjectsWithMembersVo"/>
        <where>
            <if test="projects.projectType != null and projects.projectType != ''"> and p.project_type = #{projects.projectType}</if>
            <if test="projects.name != null and projects.name != ''"> and p.name like concat('%', #{projects.name}, '%')</if>
            <if test="projects.status != null and projects.status != ''"> and p.status = #{projects.status}</if>
            <if test="projects.priority != null and projects.priority != ''"> and p.priority = #{projects.priority}</if>
            <if test="projects.customerId != null and projects.customerId != ''"> and p.customer_id = #{projects.customerId}</if>
        </where>
        ORDER BY p.created_at DESC
    </select>
</mapper>