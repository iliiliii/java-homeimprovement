<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mapper.evs.ProjectScheduleStatsMapper">

    <resultMap id="ProjectScheduleStatsResult" type="com.ruoyi.projectScheduleStats.ProjectScheduleStats">
        <result column="project_id" property="projectId"/>
        <result column="total_count" property="totalCount"/>
        <result column="completed_count" property="completedCount"/>
        <result column="in_progress_count" property="inProgressCount"/>
        <result column="progress_rate" property="progressRate"/>
    </resultMap>

    <!-- 批量查询项目进度统计 -->
    <select id="selectScheduleStatsMap" parameterType="java.util.List" resultMap="ProjectScheduleStatsResult">
        SELECT
            project_id,
            COUNT(*) as total_count,
            SUM(CASE WHEN status = 'COMPLETED' THEN 1 ELSE 0 END) as completed_count,
            SUM(CASE WHEN status = 'IN_PROGRESS' THEN 1 ELSE 0 END) as in_progress_count,
            ROUND(
                CASE
                    WHEN COUNT(*) > 0 THEN
                        SUM(CASE WHEN status = 'COMPLETED' THEN 1 ELSE 0 END) * 100.0 / COUNT(*)
                    ELSE 0
                END, 0
            ) as progress_rate
        FROM project_schedules
        WHERE project_id IN
        <foreach collection="projectIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY project_id
    </select>
</mapper>
