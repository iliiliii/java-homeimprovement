<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.ProjectSchedulesMapper">
    
    <resultMap type="ProjectSchedules" id="ProjectSchedulesResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="stage"    column="stage"    />
        <result property="stageOrder"    column="stage_order"    />
        <result property="planStartDate"    column="plan_start_date"    />
        <result property="planEndDate"    column="plan_end_date"    />
        <result property="actualStartDate"    column="actual_start_date"    />
        <result property="actualEndDate"    column="actual_end_date"    />
        <result property="status"    column="status"    />
        <result property="completionRate"    column="completion_rate"    />
        <result property="description"    column="description"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="createdBy"    column="created_by"    />
        <result property="updatedBy"    column="updated_by"    />
    </resultMap>

    <sql id="selectProjectSchedulesVo">
        select id, project_id, stage, stage_order, plan_start_date, plan_end_date, actual_start_date, actual_end_date, status, completion_rate, description, created_at, updated_at, created_by, updated_by from project_schedules
    </sql>

    <select id="selectProjectSchedulesList" parameterType="ProjectSchedules" resultMap="ProjectSchedulesResult">
        <include refid="selectProjectSchedulesVo"/>
        <where>  
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
            <if test="stage != null  and stage != ''"> and stage = #{stage}</if>
            <if test="stageOrder != null "> and stage_order = #{stageOrder}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectProjectSchedulesById" parameterType="String" resultMap="ProjectSchedulesResult">
        <include refid="selectProjectSchedulesVo"/>
        where id = #{id}
    </select>

    <insert id="insertProjectSchedules" parameterType="ProjectSchedules">
        insert into project_schedules
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectId != null and projectId != ''">project_id,</if>
            <if test="stage != null and stage != ''">stage,</if>
            <if test="stageOrder != null">stage_order,</if>
            <if test="planStartDate != null">plan_start_date,</if>
            <if test="planEndDate != null">plan_end_date,</if>
            <if test="actualStartDate != null">actual_start_date,</if>
            <if test="actualEndDate != null">actual_end_date,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="completionRate != null">completion_rate,</if>
            <if test="description != null">description,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectId != null and projectId != ''">#{projectId},</if>
            <if test="stage != null and stage != ''">#{stage},</if>
            <if test="stageOrder != null">#{stageOrder},</if>
            <if test="planStartDate != null">#{planStartDate},</if>
            <if test="planEndDate != null">#{planEndDate},</if>
            <if test="actualStartDate != null">#{actualStartDate},</if>
            <if test="actualEndDate != null">#{actualEndDate},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="completionRate != null">#{completionRate},</if>
            <if test="description != null">#{description},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateProjectSchedules" parameterType="ProjectSchedules">
        update project_schedules
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null and projectId != ''">project_id = #{projectId},</if>
            <if test="stage != null and stage != ''">stage = #{stage},</if>
            <if test="stageOrder != null">stage_order = #{stageOrder},</if>
            <if test="planStartDate != null">plan_start_date = #{planStartDate},</if>
            <if test="planEndDate != null">plan_end_date = #{planEndDate},</if>
            <if test="actualStartDate != null">actual_start_date = #{actualStartDate},</if>
            <if test="actualEndDate != null">actual_end_date = #{actualEndDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="completionRate != null">completion_rate = #{completionRate},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProjectSchedulesById" parameterType="String">
        delete from project_schedules where id = #{id}
    </delete>

    <delete id="deleteProjectSchedulesByIds" parameterType="String">
        delete from project_schedules where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>