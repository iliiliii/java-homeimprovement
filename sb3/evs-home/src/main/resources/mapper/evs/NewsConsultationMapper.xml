<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.NewsConsultationMapper">
    
    <resultMap type="NewsConsultation" id="NewsConsultationResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="subtitle"    column="subtitle"    />
        <result property="publishPosition"    column="publish_position"    />
        <result property="publishTime"    column="publish_time"    />
        <result property="publishStatus"    column="publish_status"    />
        <result property="coverImage"    column="cover_image"    />
        <result property="jumpUrl"    column="jump_url"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="deletedAt"    column="deleted_at"    />
        <result property="createdBy"    column="created_by"    />
        <result property="updatedBy"    column="updated_by"    />
    </resultMap>

    <sql id="selectNewsConsultationVo">
        select id, title, subtitle, publish_position, publish_time, publish_status, cover_image, jump_url, sort_order, created_at, updated_at, deleted_at, created_by, updated_by from news_consultation
    </sql>

    <select id="selectNewsConsultationList" parameterType="NewsConsultation" resultMap="NewsConsultationResult">
        <include refid="selectNewsConsultationVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="publishPosition != null  and publishPosition != ''"> and publish_position = #{publishPosition}</if>
            <if test="publishTime != null "> and publish_time = #{publishTime}</if>
            <if test="publishStatus != null  and publishStatus != ''"> and publish_status = #{publishStatus}</if>
            <if test="sortOrder != null "> and sort_order = #{sortOrder}</if>
        </where>
        order by sort_order desc, created_at desc
    </select>
    
    <!-- 获取当前最小排序值 -->
    <select id="selectMinSortOrder" resultType="Integer">
        select COALESCE(MIN(sort_order), 100) from news_consultation
    </select>
    
    <select id="selectNewsConsultationById" parameterType="String" resultMap="NewsConsultationResult">
        <include refid="selectNewsConsultationVo"/>
        where id = #{id}
    </select>

    <insert id="insertNewsConsultation" parameterType="NewsConsultation">
        insert into news_consultation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="subtitle != null">subtitle,</if>
            <if test="publishPosition != null and publishPosition != ''">publish_position,</if>
            <if test="publishTime != null">publish_time,</if>
            <if test="publishStatus != null and publishStatus != ''">publish_status,</if>
            <if test="coverImage != null">cover_image,</if>
            <if test="jumpUrl != null">jump_url,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="deletedAt != null">deleted_at,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="subtitle != null">#{subtitle},</if>
            <if test="publishPosition != null and publishPosition != ''">#{publishPosition},</if>
            <if test="publishTime != null">#{publishTime},</if>
            <if test="publishStatus != null and publishStatus != ''">#{publishStatus},</if>
            <if test="coverImage != null">#{coverImage},</if>
            <if test="jumpUrl != null">#{jumpUrl},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="deletedAt != null">#{deletedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateNewsConsultation" parameterType="NewsConsultation">
        update news_consultation
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="subtitle != null">subtitle = #{subtitle},</if>
            <if test="publishPosition != null and publishPosition != ''">publish_position = #{publishPosition},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="publishStatus != null and publishStatus != ''">publish_status = #{publishStatus},</if>
            <if test="coverImage != null">cover_image = #{coverImage},</if>
            <if test="jumpUrl != null">jump_url = #{jumpUrl},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteNewsConsultationById" parameterType="String">
        delete from news_consultation where id = #{id}
    </delete>

    <delete id="deleteNewsConsultationByIds" parameterType="String">
        delete from news_consultation where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>