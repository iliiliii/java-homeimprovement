<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.ProjectAttachmentMapper">
    
    <resultMap type="ProjectAttachment" id="ProjectAttachmentResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="category"    column="category"    />
        <result property="contents"    column="contents"    />
        <result property="attaUrls"    column="atta_urls"    />
        <result property="remarks"    column="remarks"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="createdBy"    column="created_by"    />
        <result property="updatedBy"    column="updated_by"    />
    </resultMap>

    <sql id="selectProjectAttachmentVo">
        select id, project_id, category, contents, atta_urls, remarks, created_at, updated_at, created_by, updated_by from project_attachment
    </sql>

    <select id="selectProjectAttachmentList" parameterType="ProjectAttachment" resultMap="ProjectAttachmentResult">
        <include refid="selectProjectAttachmentVo"/>
        <where>  
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="contents != null  and contents != ''"> and contents = #{contents}</if>
        </where>
    </select>
    
    <select id="selectProjectAttachmentById" parameterType="String" resultMap="ProjectAttachmentResult">
        <include refid="selectProjectAttachmentVo"/>
        where id = #{id}
    </select>

    <insert id="insertProjectAttachment" parameterType="ProjectAttachment">
        insert into project_attachment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectId != null">project_id,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="contents != null">contents,</if>
            <if test="attaUrls != null">atta_urls,</if>
            <if test="remarks != null">remarks,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="contents != null">#{contents},</if>
            <if test="attaUrls != null">#{attaUrls},</if>
            <if test="remarks != null">#{remarks},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateProjectAttachment" parameterType="ProjectAttachment">
        update project_attachment
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="contents != null">contents = #{contents},</if>
            <if test="attaUrls != null">atta_urls = #{attaUrls},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProjectAttachmentById" parameterType="String">
        delete from project_attachment where id = #{id}
    </delete>

    <delete id="deleteProjectAttachmentByIds" parameterType="String">
        delete from project_attachment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 查询所有项目的合同总额 -->
    <select id="selectTotalContractAmount" resultType="Double">
        SELECT COALESCE(SUM(
            CASE 
                WHEN contents REGEXP '^[0-9]+\\.?[0-9]*$' THEN CAST(contents AS DECIMAL(18,2))
                WHEN contents REGEXP '^[0-9]' THEN CAST(REGEXP_REPLACE(contents, '[^0-9.]', '') AS DECIMAL(18,2))
                ELSE 0
            END
        ), 0) as total
        FROM project_attachment
        WHERE contents IS NOT NULL 
        AND contents != ''
    </select>
</mapper>