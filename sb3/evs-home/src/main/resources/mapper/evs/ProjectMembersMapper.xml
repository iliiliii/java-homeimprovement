<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.ProjectMembersMapper">
    
    <resultMap type="ProjectMembers" id="ProjectMembersResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="userId"    column="user_id"    />
        <result property="role"    column="role"    />
        <result property="isActive"    column="is_active"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="createdBy"    column="created_by"    />
        <result property="updatedBy"    column="updated_by"    />
        <!-- 用户关联字段 -->
        <result property="userName"    column="user_name"    />
        <result property="nickName"    column="nick_name"    />
    </resultMap>

    <sql id="selectProjectMembersVo">
        select
            pm.id, pm.project_id, pm.user_id, pm.role, pm.is_active,
            pm.created_at, pm.updated_at, pm.created_by, pm.updated_by,
            u.user_name, u.nick_name
        from project_members pm
        left join sys_user u on pm.user_id = u.user_id
    </sql>

    <select id="selectProjectMembersList" parameterType="ProjectMembers" resultMap="ProjectMembersResult">
        <include refid="selectProjectMembersVo"/>
        <where>
            <if test="projectId != null and projectId != ''"> and pm.project_id = #{projectId}</if>
            <if test="userId != null and userId != ''"> and pm.user_id = #{userId}</if>
            <if test="role != null and role != ''"> and pm.role = #{role}</if>
            <if test="isActive != null"> and pm.is_active = #{isActive}</if>
        </where>
    </select>
    
    <select id="selectProjectMembersById" parameterType="String" resultMap="ProjectMembersResult">
        <include refid="selectProjectMembersVo"/>
        where id = #{id}
    </select>

    <insert id="insertProjectMembers" parameterType="ProjectMembers">
        insert into project_members
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectId != null">project_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="role != null">role,</if>
            <if test="isActive != null">is_active,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="role != null">#{role},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateProjectMembers" parameterType="ProjectMembers">
        update project_members
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="role != null">role = #{role},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProjectMembersById" parameterType="String">
        delete from project_members where id = #{id}
    </delete>

    <delete id="deleteProjectMembersByIds" parameterType="String">
        delete from project_members where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteProjectMembersByProjectId" parameterType="String">
        delete from project_members where project_id = #{projectId}
    </delete>
</mapper>