<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.web.mapper.ProjectMembersMapper">
    
    <resultMap type="ProjectMembers" id="ProjectMembersResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="userId"    column="user_id"    />
        <result property="role"    column="role"    />
        <result property="isActive"    column="is_active"    />
        <result property="addedBy"    column="added_by"    />
        <result property="addedAt"    column="added_at"    />
        <result property="removedBy"    column="removed_by"    />
        <result property="removedAt"    column="removed_at"    />
        <result property="updatedBy"    column="updated_by"    />
    </resultMap>

    <sql id="selectProjectMembersVo">
        select id, project_id, user_id, role, is_active, added_by, added_at, removed_by, removed_at, updated_by from project_members
    </sql>

    <select id="selectProjectMembersList" parameterType="ProjectMembers" resultMap="ProjectMembersResult">
        <include refid="selectProjectMembersVo"/>
        <where>  
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="role != null  and role != ''"> and role = #{role}</if>
        </where>
    </select>
    
    <select id="selectProjectMembersById" parameterType="String" resultMap="ProjectMembersResult">
        <include refid="selectProjectMembersVo"/>
        where id = #{id}
    </select>

    <insert id="insertProjectMembers" parameterType="ProjectMembers">
        insert into project_members
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="projectId != null and projectId != ''">project_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="role != null and role != ''">role,</if>
            <if test="isActive != null">is_active,</if>
            <if test="addedBy != null">added_by,</if>
            <if test="addedAt != null">added_at,</if>
            <if test="removedBy != null">removed_by,</if>
            <if test="removedAt != null">removed_at,</if>
            <if test="updatedBy != null">updated_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectId != null and projectId != ''">#{projectId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="role != null and role != ''">#{role},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="addedBy != null">#{addedBy},</if>
            <if test="addedAt != null">#{addedAt},</if>
            <if test="removedBy != null">#{removedBy},</if>
            <if test="removedAt != null">#{removedAt},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
         </trim>
    </insert>

    <update id="updateProjectMembers" parameterType="ProjectMembers">
        update project_members
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null and projectId != ''">project_id = #{projectId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="role != null and role != ''">role = #{role},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="addedBy != null">added_by = #{addedBy},</if>
            <if test="addedAt != null">added_at = #{addedAt},</if>
            <if test="removedBy != null">removed_by = #{removedBy},</if>
            <if test="removedAt != null">removed_at = #{removedAt},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteProjectMembersById" parameterType="String">
        delete from project_members where id = #{id}
    </delete>

    <delete id="deleteProjectMembersByIds" parameterType="String">
        delete from project_members where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>