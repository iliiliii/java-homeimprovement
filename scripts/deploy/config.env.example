# ====================================================================
# 逅时代装修管理系统 - 部署配置模板
# 复制此文件为 config.env 并修改为实际值
# ====================================================================

# ==================== 服务器配置 ====================
# 后端服务器
BACKEND_HOST=192.168.1.100
BACKEND_USER=root
BACKEND_PORT=22

# 管理后台服务器 (可与后端相同)
ADMIN_HOST=192.168.1.100
ADMIN_USER=root
ADMIN_PORT=22

# H5 服务器 (可与后端相同)
H5_HOST=192.168.1.100
H5_USER=root
H5_PORT=22

# SSH 密钥路径
SSH_KEY=~/.ssh/id_rsa

# ==================== 部署路径 ====================
# 后端部署路径
BACKEND_DEPLOY_PATH=/opt/evs-home/backend
BACKEND_LOG_PATH=/opt/evs-home/logs

# 管理后台部署路径
ADMIN_DEPLOY_PATH=/opt/evs-home/admin

# H5 部署路径
H5_DEPLOY_PATH=/opt/evs-home/h5

# 备份路径
BACKUP_PATH=/opt/evs-home/backup

# ==================== 域名配置 ====================
# 后端 API 域名
API_DOMAIN=api.example.com

# 管理后台域名
ADMIN_DOMAIN=admin.example.com

# H5 域名
H5_DOMAIN=h5.example.com

# ==================== JVM 配置 ====================
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
SPRING_PROFILE=prod

# ==================== 数据库配置 ====================
# 仅用于参考，实际配置在 application.yml 中
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evs_home
DB_USER=root
