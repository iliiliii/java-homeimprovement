# ====================================================================
# 逅时代装修管理系统 - 部署配置文件
# 
# 使用方法:
#   1. 复制此文件: cp config.env.example config.env
#   2. 修改 config.env 中的配置项
#   3. 运行部署脚本时会自动加载
# ====================================================================

# ==================== 部署模式 ====================
# local  - 本地部署 (默认)
# remote - 远程部署
DEPLOY_MODE=local

# ==================== 远程服务器配置 ====================
# 远程部署时使用，本地部署可忽略
REMOTE_HOST=192.168.1.100
REMOTE_USER=root
REMOTE_PORT=22
SSH_KEY=~/.ssh/id_rsa

# ==================== 后端部署路径 ====================
# 后端 JAR 包部署路径
BACKEND_DEPLOY_PATH=/opt/evs-home/backend
# 后端日志路径
BACKEND_LOG_PATH=/opt/evs-home/logs

# ==================== 前端部署路径 ====================
# 管理后台静态文件路径
ADMIN_DEPLOY_PATH=/opt/evs-home/admin
# H5 静态文件路径
H5_DEPLOY_PATH=/opt/evs-home/h5

# ==================== 备份路径 ====================
BACKUP_PATH=/opt/evs-home/backup

# ==================== JVM 配置 ====================
# 后端 JVM 参数
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
# Spring Profile: 留空使用项目默认配置，或指定如 druid/prod
# SPRING_PROFILE=

# ==================== Nginx 配置 ====================
NGINX_CONF_PATH=/etc/nginx/conf.d

# ==================== 域名配置 (仅供参考) ====================
# 后端 API 域名
# API_DOMAIN=api.example.com
# 管理后台域名
# ADMIN_DOMAIN=admin.example.com
# H5 域名
# H5_DOMAIN=h5.example.com
