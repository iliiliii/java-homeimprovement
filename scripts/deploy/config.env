# 逅时代装修管理系统 - 部署配置

# ==================== 部署路径 ====================
# 后端
BACKEND_PATH=/opt/evs-home/backend
BACKEND_LOG=/opt/evs-home/logs/backend.log

# 管理后台
ADMIN_PATH=/opt/evs-home/admin

# H5
H5_PATH=/opt/evs-home/h5

# ==================== JVM 配置 ====================
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
