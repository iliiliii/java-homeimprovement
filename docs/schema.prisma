// Prisma Schema for Better-Auth Integration
// Version 5.0 - Better-Auth + Next.js 15 + SQLite
// 完全兼容 Better-Auth RBAC 系统

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== Better-Auth 核心表 ====================

// 用户表 - Better-Auth 兼容设计
model User {
  id            String   @id @default(cuid())

  // Better-Auth 必需字段
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  // 业务扩展字段
  username      String?  @unique
  phone         String?  @unique // 手机号字段，直接使用phone
  realName      String?
  userType      String   @default("INTERNAL")
  status        String   @default("ACTIVE")

  // 微信信息
  wechatOpenId  String?  @unique
  wechatUnionId String?
  wechatNickName String?
  wechatAvatar  String?

  // Admin 插件字段
  role          String   @default("user")
  banned        Boolean  @default(false)
  banReason     String?
  banExpires    DateTime?

  // Better-Auth 关系
  sessions      Session[]
  accounts      Account[]

  // RBAC 关系
  userRoles     UserRole[]
  projectMembers ProjectMember[]

  // 审计字段
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([phone])
  @@map("user")
}

// Session 表 - Better-Auth 会话管理
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Admin 插件字段
  impersonatedBy String?

  @@map("session")
}

// Account 表 - Better-Auth 账户管理（支持多种认证方式）
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   // 密码哈希存储在这里
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

// Verification 表 - Better-Auth 验证管理（邮箱验证、密码重置等）
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ==================== 业务表（保留原有设计）====================

// 字典表 - 替代枚举，支持动态配置
model Dict {
  id        String   @id @default(cuid())
  dictType  String   @default("")
  dictKey   String   @default("")
  dictValue String   @default("")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dictType, dictKey])
  @@index([dictType])
  @@map("dict")
}

// 客户表
model Customer {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?  @unique
  address         String?
  level           String   @default("NORMAL")
  source          String?
  remarks         String?
  avatar          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  deletedBy       String?

  // 关联关系
  projects        Project[]

  // 索引
  @@index([level])
  @@index([isActive, deletedAt])
  @@index([name])
  @@index([phone])
  @@index([level, createdAt])
  @@map("customers")
}

// 项目表
model Project {
  id          String   @id @default(cuid())
  name        String
  customerId  String
  description String?
  address     String
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("PLANNING")
  priority    String   @default("MEDIUM")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  // 关联关系
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  qualityInspections QualityInspection[]
  files       FileUpload[]

  // 索引
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([isActive, deletedAt])
  @@index([name])
  @@index([address])
  @@index([customerId, status])
  @@index([status, priority])
  @@map("projects")
}

// 质检表
model QualityInspection {
  id           String   @id @default(cuid())
  projectId    String
  type         String
  description  String
  result       String   @default("PENDING")
  notes        String?
  images       String?
  inspectorId  String
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  // 关联关系
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 索引
  @@index([projectId])
  @@index([result])
  @@index([type])
  @@index([inspectorId])
  @@index([isActive, deletedAt])
  @@index([projectId, result])
  @@map("quality_inspections")
}

// 问题表
model QualityIssue {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  description   String
  severity      String   @default("MEDIUM")
  category      String
  location      String?
  images        String   @default("[]")
  status        String   @default("OPEN")
  reportedBy    String
  reportedByName String
  resolvedBy    String?
  resolvedByName String?
  resolvedAt    DateTime?
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([projectId])
  @@index([severity])
  @@index([status])
  @@map("quality_issues")
}

// 问题修复表
model QualityFix {
  id             String   @id @default(cuid())
  issueId        String
  fixDescription String
  images         String   @default("[]")
  status         String   @default("PENDING")
  fixedBy        String
  fixedByName    String
  fixedAt        DateTime?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([issueId])
  @@index([status])
  @@map("quality_fixes")
}

// 文件上传表
model FileUpload {
  id           String   @id @default(cuid())
  uploaderId   String
  uploaderName String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  url          String
  type         String   @default("OTHER")
  tags         String   @default("[]")
  category     String?
  description  String?
  projectId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  updatedBy    String?

  // 关联关系
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 索引
  @@index([uploaderId])
  @@index([type])
  @@index([category])
  @@index([projectId])
  @@index([isActive, deletedAt])
  @@index([projectId, isActive])
  @@map("file_uploads")
}

// 通知表
model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String
  type        String   @default("SYSTEM")
  status      String   @default("UNREAD")
  relatedId   String?
  relatedType String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("notifications")
}

// 活动日志表
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  action      String
  resource    String
  resourceId  String?
  description String
  oldValues   String?
  newValues   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@map("activity_logs")
}

// ==================== RBAC 权限管理表 ====================

// 角色表
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String?
  description String?
  level       Int      @default(0) // 角色层级，数字越大权限越高
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  users       UserRole[]
  permissions RolePermission[]
  projectMembers ProjectMember[]

  @@index([level])
  @@map("roles")
}

// 权限表
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  resource    String   // 资源类型：customers, projects, quality, users, settings, files, reports
  action      String   // 操作类型：read, create, update, delete, approve, manage, export
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联关系
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([action])
  @@map("permissions")
}

// 用户角色关联表
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  assignedBy String? // 分配者ID
  assignedAt DateTime @default(now())
  expiresAt DateTime? // 角色过期时间，可选

  // 关联关系
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// 角色权限关联表
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // 关联关系
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==================== 项目相关业务表 ====================

// 项目成员表
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleId    String
  isActive  Boolean  @default(true)
  addedBy   String?
  addedAt   DateTime @default(now())
  removedBy String?
  removedAt DateTime?
  updatedBy String?

  // 关联关系
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // 索引
  @@unique([projectId, userId, isActive])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
  @@index([isActive])
  @@index([projectId, isActive])
  @@map("project_members")
}


// 数据级权限表 - 用于更细粒度的数据访问控制
model DataPermission {
  id          String   @id @default(cuid())
  userId      String
  resource    String   // 资源类型：project, customer, file等
  resourceId  String   // 资源ID
  accessLevel String   // 访问级别：read, write, manage
  grantedBy   String?  // 授权者ID
  expiresAt   DateTime? // 权限过期时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, resource, resourceId])
  @@index([userId])
  @@index([resource])
  @@index([resourceId])
  @@map("data_permissions")
}
